{
    "rewrites": [
        {
            "source": "/",
            "destination": "/Client/home.html"
        },
        {
            "source": "/home",
            "destination": "/Client/home.html"
        },
        {
            "source": "/reviews",
            "destination": "/Client/review.html"
        },
        {
            "source": "/contact",
            "destination": "/Client/contactus.html"
        },
        {
            "source": "/admin",
            "destination": "/Admin/login.html"
        },
        {
            "source": "/admin/login",
            "destination": "/Admin/login.html"
        },
        {
            "source": "/admin/dashboard",
            "destination": "/Admin/admin.html"
        },
        {
            "source": "/admin/reviews",
            "destination": "/Admin/admin-review.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ]
}